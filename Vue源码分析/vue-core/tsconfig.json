{
  "extends": ["@tsconfig/recommended"],
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es2016",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ES2016"],
    "types": ["vitest/globals", "node"],
    "paths": {
      "@alvis/*": ["packages/*/src/index.ts"],
      "vue": ["packages/vue/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/**/__tests__/**/*.test.ts",
    "packages/**/__tests__/**/*.spec.ts"
  ]
}
