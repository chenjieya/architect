{
  "extends": ["@tsconfig/recommended"],
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es2016",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ES2016"],
    "types": ["node"],
    "paths": {
      "@alvis/*": ["packages/*/src"],
      "vue": ["packages/vue/src"]
    }
  },
  "include": ["packages/*/src"]
}
