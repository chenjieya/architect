{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["types/**.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*", "node_modules"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
      // "unplugin-vue-setup-extend-plus/*": ["node_modules/unplugin-vue-setup-extend-plus/*"]
    }
  }
}
